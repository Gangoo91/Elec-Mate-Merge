# Elec-Mate — client-side environment variables (template).
# Copy to .env and fill in. These VITE_ vars are bundled into the browser build
# and are therefore public by design. Server-side secrets (service role, Stripe
# secret, etc.) live in Supabase Function secrets / Vercel env vars — NOT here.

VITE_SUPABASE_PROJECT_ID=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_URL=
VITE_VAPID_PUBLIC_KEY=

# Google Maps API Key
VITE_GOOGLE_MAPS_API_KEY=

# Sentry Error Tracking
VITE_SENTRY_DSN=

# PostHog Analytics
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=

# RevenueCat API Keys (public keys - safe for client-side)
VITE_REVENUECAT_IOS_KEY=
VITE_REVENUECAT_ANDROID_KEY=
VITE_META_PIXEL_ID=
